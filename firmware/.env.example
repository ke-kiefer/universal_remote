# Copy to .env and fill in. .env is gitignored – never commit it.
# Values are compiled into the firmware: after a change, rebuild and flash.

# --- required -------------------------------------------------------------------------
# 2.4 GHz network (the ESP32-S3 has no 5 GHz)
WIFI_SSID=
WIFI_PASSWORD=
# Server address as seen from the remote (LAN IP of the server machine, no trailing slash)
SERVER_URL=http://192.168.1.100:8010
# Must match API_KEY in server/.env
API_KEY=

# --- optional (defaults shown) --------------------------------------------------------
# Sent as ?device=... with every image
DEVICE_NAME=remote1
# QVGA VGA SVGA XGA HD SXGA UXGA FHD QXGA QSXGA (HD/FHD are 16:9 and cropped – avoid)
CAMERA_FRAMESIZE=SVGA
# 0-63, lower = better quality and larger files
CAMERA_JPEG_QUALITY=12
# 10 MHz: 20 MHz disturbs the WLAN on this board (and can cause image artefacts)
CAMERA_XCLK_MHZ=10
CAMERA_HMIRROR=1
CAMERA_VFLIP=0
# Autofocus: single = focus on each photo, continuous = lens tracks all the time
# (photo is sharp immediately, slightly more power), off = fixed lens
AF_MODE=continuous
# Max time to wait for autofocus before capturing anyway
AF_TIMEOUT_MS=1500
BACKLIGHT_PCT=80
# Power saving after touch inactivity (0 = never). The first touch afterwards only wakes.
# Dim the backlight to DIM_PCT after DIM_AFTER_S seconds
DIM_AFTER_S=20
DIM_PCT=10
# Then backlight off, camera standby (and WLAN modem sleep if IDLE_WIFI_POWER_SAVE=1)
IDLE_AFTER_S=45
IDLE_WIFI_POWER_SAVE=1
# Then sleep (light sleep, WLAN and display off). A touch or the BOOT key wakes it up
# instantly, WLAN reconnects in ~3-4 s. 0 = never
SLEEP_AFTER_S=300
# 0 = no sleep while connected to a PC (keeps the serial log), chargers don't count
SLEEP_ON_USB=0
# Switch off below this battery voltage (protects the LiPo), BOOT key to restart. 0 = off.
# A long press on the power button (home screen) switches off as well.
BATTERY_OFF_V=3.4
# Max WLAN TX power in dBm (0 = driver default ~20 dBm). Lower values (e.g. 8.5) can
# help boards with a poorly matched antenna.
WIFI_TX_POWER_DBM=0
