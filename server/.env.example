# Copy to .env and fill in. .env is gitignored – never commit it.

# --- Home Assistant -------------------------------------------------------------------
HA_URL=http://192.168.1.100:8123
# Long-Lived Access Token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=
# Cache for entity names/areas in seconds
HA_CACHE_SECONDS=300

# --- Auth -----------------------------------------------------------------------------
# Shared secret: the remote sends it as X-Api-Key, the label UI uses it as
# Basic-Auth password (any username). Generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=

# --- Storage --------------------------------------------------------------------------
# /data inside Docker; for local `uv run` from server/ use ../data
DATA_DIR=../data
CAPTURE_RETENTION_DAYS=7
MAX_UPLOAD_BYTES=2097152
# Rotate uploaded images clockwise for upright display (0/90/180/270), depending on
# how the camera is mounted. Lossless (EXIF tag). Changing it later only affects new
# images; for consistent training data relabel or keep it fixed.
IMAGE_ROTATION=0

# --- Recognition ----------------------------------------------------------------------
MODEL_NAME=dinov2_small
# Model input WxH (landscape; swapped automatically for portrait images).
# Both edges must be multiples of 14. 224x168 = fast, 448x336 = more detail (~4x slower).
MODEL_INPUT_SIZE=224x168
# Views per image: 1.0 = whole image (always included). Extra center crops e.g. 1.0,0.5
CROP_SCALES=1.0
# Embedding: cls = CLS token, cls_mean = CLS + mean of patch tokens
POOLING=cls_mean
# Entity score = mean of its TOP_M best image similarities
TOP_M=3
# Calibrate with `uv run python -m app.eval`
MATCH_THRESHOLD=0.60
MARGIN_THRESHOLD=0.03
UNKNOWN_THRESHOLD=0.40

# --- Server ---------------------------------------------------------------------------
# 0.0.0.0 = reachable from the LAN (the remote needs that)
HOST=0.0.0.0
# 8000 is taken on the dev machine by another project
PORT=8010
